                  },
                  "kind": {
                    "description": "Relationship kind the caller proposes to assert.",
                    "type": "string"
                  }
                },
                "required": [
                  "discovery_id",
                  "kind"
                ],
                "title": "IssueDiscoveryInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/packs/exocortex-pack-mortgage-v1/AttachRuleFinding": {
      "post": {
        "operationId": "exocortex-pack-mortgage-v1.AttachRuleFinding",
