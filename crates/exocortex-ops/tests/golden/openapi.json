              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `list_audit_records`.",
                "properties": {
                  "since_lsn": {
                    "default": 0,
                    "description": "Only records after this LSN.",
                    "format": "uint64",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "title": "ListAuditInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/discoveries": {
