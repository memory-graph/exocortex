                  "finding_content": {
                    "type": "string"
                  },
                  "finding_title": {
                    "type": "string"
                  },
                  "loan": {
                    "type": "string"
                  },
                  "rule": {
                    "type": "string"
                  }
                },
                "required": [
                  "finding_content",
                  "finding_title",
                  "loan",
                  "rule"
                ],
                "title": "Input",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/packs/exocortex-pack-mortgage-v1/IsCategoricallyEligible": {
      "post": {
        "operationId": "exocortex-pack-mortgage-v1.IsCategoricallyEligible",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "properties": {
                  "categorical_kind": {
                    "type": "string"
                  },
                  "income_verified": {
                    "type": "boolean"
                  }
                },
