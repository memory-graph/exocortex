        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `list_discoveries`.",
                "properties": {
                  "limit": {
                    "default": 20,
                    "description": "Maximum rows to return (hard-capped at 100).",
                    "format": "uint32",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "title": "ListDiscoveriesInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
