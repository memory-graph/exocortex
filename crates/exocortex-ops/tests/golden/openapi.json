{
  "info": {
    "title": "exocortex",
    "version": "0.2.2"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/accept_discovery": {
      "post": {
        "operationId": "accept_discovery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `accept_discovery`.",
                "properties": {
                  "discovery_id": {
                    "description": "Discovery id (UUID).",
                    "type": "string"
                  },
                  "from": {
                    "description": "Hex from-memory id.",
                    "type": "string"
                  },
                  "kind": {
                    "description": "Kind display name.",
                    "type": "string"
                  },
                  "to": {
                    "description": "Hex to-memory id.",
                    "type": "string"
                  }
                },
                "required": [
                  "discovery_id",
                  "from",
                  "kind",
                  "to"
                ],
                "title": "AcceptDiscoveryInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/audit": {
      "get": {
        "operationId": "list_audit_records",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `list_audit_records`.",
                "properties": {
                  "since_lsn": {
                    "default": 0,
                    "description": "Only records after this LSN.",
                    "format": "uint64",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "title": "ListAuditInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/discoveries": {
      "get": {
        "operationId": "list_discoveries",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `list_discoveries`.",
                "properties": {
                  "limit": {
                    "default": 20,
                    "description": "Maximum rows to return (hard-capped at 100).",
                    "format": "uint32",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "title": "ListDiscoveriesInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/explain_edge": {
      "post": {
        "operationId": "explain_edge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `explain_edge`.",
                "properties": {
                  "edge": {
                    "description": "Hex relationship id.",
                    "type": "string"
                  }
                },
                "required": [
                  "edge"
                ],
                "title": "ExplainEdgeInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/find_related": {
      "post": {
        "operationId": "find_related",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `find_related`.",
                "properties": {
                  "anchor": {
                    "description": "Anchor memory (hex id).",
                    "type": "string"
                  },
                  "k": {
                    "default": 2,
                    "description": "Hop bound (hard-capped at 4).",
                    "format": "uint8",
                    "minimum": 0.0,
                    "type": "integer"
                  }
                },
                "required": [
                  "anchor"
                ],
                "title": "FindRelatedInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/get_chain": {
      "post": {
        "operationId": "get_chain",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `get_chain`.",
                "properties": {
                  "max_depth": {
                    "default": 2,
                    "description": "Depth bound (hard-capped at 4).",
                    "format": "uint8",
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "memory": {
                    "description": "Hex memory id.",
                    "type": "string"
                  }
                },
                "required": [
                  "memory"
                ],
                "title": "GetChainInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/get_memory": {
      "post": {
        "operationId": "get_memory",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `get_memory`.",
                "properties": {
                  "id": {
                    "description": "Hex memory id.",
                    "type": "string"
                  }
                },
                "required": [
                  "id"
                ],
                "title": "GetMemoryInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/issue_discovery": {
      "post": {
        "operationId": "issue_discovery",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `issue_discovery`.",
                "properties": {
                  "discovery_id": {
                    "description": "Durable discovery id.",
                    "type": "string"
                  },
                  "kind": {
                    "description": "Relationship kind the caller proposes to assert.",
                    "type": "string"
                  }
                },
                "required": [
                  "discovery_id",
                  "kind"
                ],
                "title": "IssueDiscoveryInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/preflight_wrapup": {
      "post": {
        "operationId": "preflight_wrapup",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "definitions": {
                  "PreflightEdgeHint": {
                    "description": "One proposed edge (§13.5 + §4.5 shape).",
                    "properties": {
                      "from_draft_key": {
                        "description": "Source draft key.",
                        "type": "string"
                      },
                      "kind": {
                        "description": "MUST match a registered kind display_name.",
                        "type": "string"
                      },
                      "strength": {
                        "default": 0.0,
                        "description": "0 = RelMeta default.",
                        "format": "float",
                        "type": "number"
                      },
                      "to_draft_key": {
                        "default": "",
                        "description": "Target draft key (within this batch) — or empty when `to_memory_id` is set.",
                        "type": "string"
                      },
                      "to_memory_id": {
                        "default": "",
                        "description": "§4.5: an EXISTING memory by 32-hex id (cross-batch edge).",
                        "type": "string"
                      }
                    },
                    "required": [
                      "from_draft_key",
                      "kind"
                    ],
                    "type": "object"
                  },
                  "PreflightMemoryDraft": {
                    "description": "One proposed memory draft (§13.5 shape; the client's MCP arg type re-exports this so the tool schema and the registry schema are ONE).",
                    "properties": {
                      "content": {
                        "description": "Free-text content.",
                        "type": "string"
                      },
                      "draft_key": {
                        "description": "Links edges within this batch.",
                        "type": "string"
                      },
                      "memory_type": {
                        "description": "MUST match a registered MemoryType label.",
                        "type": "string"
                      },
                      "tags": {
                        "default": [],
                        "description": "Lowercase tags (normalized at commit).",
                        "items": {
                          "type": "string"
                        },
                        "type": "array"
                      },
                      "title": {
                        "description": "1..=200 chars (R-T5).",
                        "type": "string"
                      },
                      "visibility": {
                        "description": "\"private\"|\"project\"|\"team\"|\"org\" (R-T6).",
                        "type": "string"
                      }
                    },
                    "required": [
                      "content",
                      "draft_key",
                      "memory_type",
                      "title",
                      "visibility"
                    ],
                    "type": "object"
                  }
                },
                "description": "Input for `preflight_wrapup`.",
                "properties": {
                  "edges": {
                    "default": [],
                    "description": "Proposed edges.",
                    "items": {
                      "$ref": "#/definitions/PreflightEdgeHint"
                    },
                    "type": "array"
                  },
                  "memories": {
                    "description": "Proposed memory drafts.",
                    "items": {
                      "$ref": "#/definitions/PreflightMemoryDraft"
                    },
                    "type": "array"
                  },
                  "project_id": {
                    "default": "",
                    "description": "Project id (future context stamping; unused by validation).",
                    "type": "string"
                  }
                },
                "required": [
                  "memories"
                ],
                "title": "PreflightWrapupInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/promote_visibility": {
      "post": {
        "operationId": "promote_visibility",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `promote_visibility`.",
                "properties": {
                  "memory_id": {
                    "description": "Hex memory id.",
                    "type": "string"
                  },
                  "to": {
                    "description": "Target visibility: \"project\"|\"team\"|\"org\".",
                    "type": "string"
                  }
                },
                "required": [
                  "memory_id",
                  "to"
                ],
                "title": "PromoteVisibilityInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/retract_edge": {
      "post": {
        "operationId": "retract_edge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `retract_edge`.",
                "properties": {
                  "edge_id": {
                    "description": "Hex relationship id.",
                    "type": "string"
                  },
                  "reason": {
                    "description": "Human-readable reason, kept in the audit log.",
                    "type": "string"
                  }
                },
                "required": [
                  "edge_id",
                  "reason"
                ],
                "title": "RetractEdgeInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/search_memories": {
      "post": {
        "operationId": "search_memories",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$schema": "http://json-schema.org/draft-07/schema#",
                "description": "Input for `search_memories`.",
                "properties": {
                  "limit": {
                    "default": 20,
                    "description": "Result cap.",
                    "format": "uint32",
                    "minimum": 0.0,
                    "type": "integer"
                  },
                  "query": {
                    "description": "Free-text query.",
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ],
                "title": "SearchInput",
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
