      "properties": {
        "memory_id": {
          "description": "Hex memory id.",
          "type": "string"
        },
        "to": {
          "description": "Target visibility: \"project\"|\"team\"|\"org\".",
          "type": "string"
        }
      },
      "required": [
        "memory_id",
        "to"
      ],
      "title": "PromoteVisibilityInput",
      "type": "object"
    },
    "name": "exocortex.promote_visibility"
  },
