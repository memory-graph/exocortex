          "description": "Anchor memory (hex id).",
          "type": "string"
        },
        "k": {
          "default": 2,
          "description": "Hop bound (hard-capped at 4).",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "anchor"
      ],
      "title": "FindRelatedInput",
      "type": "object"
    },
    "name": "exocortex.find_related"
  },
  {
